{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@connectors/*": ["packages/connectors/src/*"],
      "@ai/*": ["packages/ai/src/*"],
      "@n8n/*": ["packages/n8n/src/*"],
      "@common/*": ["packages/common/src/*"]
    }
  }
}
